{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js", "${CLAUDE_PLUGIN_DATA}"] }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.js", "${CLAUDE_PLUGIN_DATA}"] }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-write.js", "${CLAUDE_PLUGIN_DATA}"] }
        ]
      },
      {
        "matcher": "mcp__github__merge_pull_request",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-merge-mcp.js", "${CLAUDE_PLUGIN_DATA}"] }
        ]
      },
      {
        "matcher": "Skill|Task|Agent",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.js", "${CLAUDE_PLUGIN_DATA}"] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/post-bash-rules.js", "${CLAUDE_PLUGIN_DATA}"] }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/memory-redact.js", "${CLAUDE_PLUGIN_DATA}"] }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/stop-git-check.js", "${CLAUDE_PLUGIN_DATA}"] }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-flush.js", "${CLAUDE_PLUGIN_DATA}"] }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/subagent-telemetry.js", "${CLAUDE_PLUGIN_DATA}"] }
        ]
      }
    ]
  }
}
