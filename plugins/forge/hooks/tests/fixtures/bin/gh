#!/usr/bin/env node
'use strict';
// Fake `gh` for hook tests. Understands only what the merge-control code calls:
//   gh pr view [<id>] --json baseRefName -q .baseRefName   prints $FAKE_GH_BASE_REF (default "main")
//   gh pr view [<id>] --json number -q .number            prints $FAKE_GH_PR_NUMBER (default "7")
//   gh pr list ... -q .[].number    prints $FAKE_GH_OPEN_PRS (comma list, default "7"), one per line
//   gh pr checks N --json name,bucket   prints a JSON array steered by
//     $FAKE_GH_CHECKS = pass (default) | fail | pending | none | unreadable
//   gh api repos/<o>/<r>/pulls/<n>     prints {title: $FAKE_GH_PR_TITLE ("Fake title"),
//     body: $FAKE_GH_PR_BODY ("Fake body"), base: {ref: $FAKE_GH_BASE_REF}}
//   gh api repos/<o>/<r>/rules/branches/<b>   prints $FAKE_GH_RULES (JSON, default "[]")
// $FAKE_GH_FAIL makes every call exit 1 (gh missing / no network). Any other
// invocation exits 1 with nothing on stdout. Defaults mean tests that never set
// these see the same behavior as before the merge-control work.
const args = process.argv.slice(2);
if (process.env.FAKE_GH_FAIL) process.exit(1);
if (args[0] === 'api' && /^repos\/[^/]+\/[^/]+\/pulls\/\d+$/.test(args[1] || '')) {
  process.stdout.write(JSON.stringify({
    title: process.env.FAKE_GH_PR_TITLE === undefined ? 'Fake title' : process.env.FAKE_GH_PR_TITLE,
    body: process.env.FAKE_GH_PR_BODY === undefined ? 'Fake body' : process.env.FAKE_GH_PR_BODY,
    base: { ref: process.env.FAKE_GH_BASE_REF || 'main' },
  }));
  process.exit(0);
}
if (args[0] === 'api' && /\/rules\/branches\//.test(args[1] || '')) {
  process.stdout.write(process.env.FAKE_GH_RULES || '[]');
  process.exit(0);
}
if (args[0] === 'pr' && args[1] === 'view' && args.includes('number')) {
  process.stdout.write((process.env.FAKE_GH_PR_NUMBER || '7') + '\n');
  process.exit(0);
}
if (args[0] === 'pr' && args[1] === 'view') {
  process.stdout.write((process.env.FAKE_GH_BASE_REF || 'main') + '\n');
  process.exit(0);
}
if (args[0] === 'pr' && args[1] === 'list') {
  const open = (process.env.FAKE_GH_OPEN_PRS === undefined ? '7' : process.env.FAKE_GH_OPEN_PRS).split(',').filter(Boolean);
  process.stdout.write(open.join('\n') + (open.length ? '\n' : ''));
  process.exit(0);
}
if (args[0] === 'pr' && args[1] === 'checks') {
  const mode = process.env.FAKE_GH_CHECKS || 'pass';
  if (mode === 'unreadable') process.exit(1);
  const rows = {
    pass: [{ name: 'validate', bucket: 'pass' }, { name: 'forge validators', bucket: 'pass' }],
    fail: [{ name: 'validate', bucket: 'fail' }],
    pending: [{ name: 'validate', bucket: 'pending' }],
    none: [],
  }[mode] || [];
  process.stdout.write(JSON.stringify(rows));
  process.exit(0);
}
process.exit(1);
