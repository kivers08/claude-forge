{
  "enabledPlugins": {
    "forge@claude-forge": true,
    "smoke@claude-forge": true
  },
  "extraKnownMarketplaces": {
    "claude-forge": {
      "source": {
        "source": "github",
        "repo": "kewi-development/claude-forge"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" }
        ]
      }
    ]
  }
}
